#!/usr/bin/env python3
import http.server
import socketserver
import json
import os

# 必须使用平台指定的 Unix Socket 路径
SOCKET_PATH = "/var/api/myapp.sock"

class MyHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({"status": "ok"}).encode())
        else:
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({
                "app": "myapp", 
                "version": "1.0.0", 
                "message": "Hello from MyApp!"
            }).encode())

    def log_message(self, format, *args):
        pass # 关闭默认的每次请求打印，保持日志干净

if __name__ == '__main__':
    # 确保父目录存在 (通常 /var/api 由 systemd 的 ReadWritePaths 保证，这里做个兜底)
    os.makedirs(os.path.dirname(SOCKET_PATH), exist_ok=True)
    
    # 如果 socket 文件已存在，先清理
    if os.path.exists(SOCKET_PATH):
        os.remove(SOCKET_PATH)

    # 使用 UnixStreamServer 监听 Unix Socket
    class ThreadingUnixStreamServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    server = ThreadingUnixStreamServer(SOCKET_PATH, MyHandler)
    
    # 设置为应用用户权限 (防止 root 运行导致权限错误)
    os.chmod(SOCKET_PATH, 0o660)
    
    print(f"Server listening on {SOCKET_PATH}")
    server.serve_forever()
