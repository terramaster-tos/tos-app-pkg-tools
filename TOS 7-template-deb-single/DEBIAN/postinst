#!/bin/bash
# Post-installation script — runs after the package is installed
set -e

APPID="myapp"
APP_DIR="/usr/local/${APPID}"

# The application user is created by the platform during installation.
# Do not add a useradd command here - see 08_Deb_Development.md section 8.14
# (preinst) and 10_Permission_Model.md: "Developers MUST NOT manually create
# the user in lifecycle scripts".

# Runtime data directory. It must exist before the service starts: systemd
# fails with 226/NAMESPACE if a path listed in ReadWritePaths is missing.
mkdir -p "/var/lib/${APPID}"

# Set permissions
chown -R "${APPID}:${APPID}" "${APP_DIR}" 2>/dev/null || true
chown -R "${APPID}:${APPID}" "/var/lib/${APPID}" 2>/dev/null || true

# Decompress webui.bz2 if present
if [ -f "${APP_DIR}/webui.bz2" ]; then
    (cd "${APP_DIR}" && tar -xjf webui.bz2 2>/dev/null) || true
fi

# Enable and start service
systemctl daemon-reload
systemctl enable "${APPID}.service" 2>/dev/null || true
systemctl start "${APPID}.service" 2>/dev/null || true

echo "${APPID} installed successfully."
exit 0
