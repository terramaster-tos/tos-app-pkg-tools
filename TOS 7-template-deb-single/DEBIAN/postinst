#!/bin/bash
# Post-installation script — runs after the package is installed
set -e

APPID="myapp"
APP_DIR="/usr/local/${APPID}"

# Create runtime dirs; tolerate failure, suppress error log, do not block installation
# Note: /var/api must be created here if it's listed in ReadWritePaths in the .service file
mkdir -p "/usr/local/${APPID}/data" "/usr/local/${APPID}/logs" "/var/api" 2>/dev/null || true

# Set permissions (No longer needs /var/lib, completely clean)
chown -R "${APPID}:${APPID}" "${APP_DIR}" 2>/dev/null || true

# Decompress webui.bz2 if present
if [ -f "${APP_DIR}/webui.bz2" ]; then
    (cd "${APP_DIR}" && tar -xjf webui.bz2 2>/dev/null) || true
fi

# $1 = "configure" (also on upgrade), $2 = the version that was installed before
case "$1" in
    configure)
        if [ -n "$2" ]; then
            # Upgrade path: $2 holds the old version — do the data migration
            # required by §4.3 here (never delete user data on upgrade).
            echo "${APPID}: upgrading from version $2 ..."
        fi
        # Enable and start the service. This is idempotent, and it is done on
        # BOTH the fresh-install and the upgrade path, so an upgrade never
        # leaves the service disabled / stopped.
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable "${APPID}.service" 2>/dev/null || true
        systemctl start "${APPID}.service" 2>/dev/null || true
        ;;
    *)
        ;;
esac

echo "${APPID} installed successfully."
exit 0
