#!/bin/bash
# Post-removal script — runs after the package is removed
set -e

APPID="myapp"

systemctl daemon-reload

if [ "$1" = "purge" ]; then
    # (User deletion is handled by the platform automatically. 
    # DO NOT use userdel here.)

    # Clean up persistent data and app directory
    rm -rf "/usr/local/${APPID}" 2>/dev/null || true
    rm -f "/var/api/${APPID}.sock" 2>/dev/null || true
    
    # Note: The systemd unit file is installed under /usr/local/<appid>/init.d/ 
    # and is removed automatically by dpkg. Do not manually delete from /etc/systemd/system.
    
    systemctl daemon-reload 2>/dev/null || true
fi

exit 0
